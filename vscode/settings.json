{
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.fontSize": 13,
  "editor.fontFamily": "Hack Nerd Font",
  "editor.fontLigatures": true,
  "editor.formatOnSave": true,
  "editor.hover.enabled": false,
  "editor.inlineSuggest.enabled": true,
  "editor.minimap.enabled": false,
  "editor.tabCompletion": "on",
  "editor.rulers": [106],
  "editor.suggestSelection": "first",
  "editor.wordWrap": "wordWrapColumn",
  "editor.wordWrapColumn": 105,
  "eslint.defaultFormatter": "esbenp.prettier-vscode",
  "eslint.format.enable": true,
  "eslint.quiet": true,
  "eslint.run": "onSave",
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "files.exclude": {
    "**/node_modules": true,
    "**/.classpath": true,
    "**/.project": true,
    "**/.settings": true,
    "**/.factorypath": true,
    "**/Pods": true
  },
  "files.associations": {
    ".babelrc": "jsonc",
    ".eslintrc": "jsonc",
    "*.pyi": "python",
    "*.conf": "NGINX",
    "*.ts": "typescript",
    "**/views/**/*.html": "django-html",
    "**/*.html.j2": "django-html",
    "*.tpl": "django-html",
    "*.erb": "erb",
    ".env*": "dotenv",
    "*.bats": "shellscript",
    "*.sh": "shellscript",
    "*.nanorc": "shellscript"
  },
  "javascript.updateImportsOnFileMove.enabled": "always",
  "material-icon-theme.folders.theme": "specific",
  // "python.linting.enabled": true,
  // "python.linting.flake8Enabled": true,
  // "python.linting.flake8Args": [
  //   "--max-line-length=120",
  //   "--ignore=E501,E402,F841,F401,E302,E305",
  //   "--exclude=**/migrations/*"
  // ],
  // "python.jediEnabled": false,
  "telemetry.telemetryLevel": "off",
  "terminal.external.osxExec": "Alacritty",
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.profiles.osx": {
    "zsh": {
      "path": "zsh",
      "args": ["-l"]
    },
    "bash": {
      "path": "bash",
      "args": ["-l"]
    }
  },
  "terminal.integrated.defaultProfile.osx": "zsh", // or "bash" depending on your shell
  "terminal.integrated.env.osx": {
    "NVM_DIR": "$HOME/.nvm",
    "NODE_ENV": "development"
  },
  "terminal.integrated.env.linux": {
  "NVM_DIR": "$HOME/.nvm",
  "NODE_ENV": "development"
  },
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "vsintellicode.modify.editor.suggestSelection": "automaticallyOverrodeDefaultValue",
  "window.title": "",
  "workbench.colorTheme": "Ayu Mirage",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.panel.defaultLocation": "bottom",
  "workbench.statusBar.visible": true,
  "zenMode.centerLayout": false,
  "zenMode.fullScreen": false,
  "zenMode.restore": true,
  "search.mode": "newEditor",
  "workbench.colorCustomizations": {
    "editorWarning.foreground": "#ffff00", // Warnings inside the file
    "editorError.foreground": "#f66", // Errors inside the file
    "list.warningForeground": "#e45bff", // Warnings on the file name
    "list.errorForeground": "#f66", // Errors on the file name
    "notebook.cellEditorBackground": "#2e2e2e",
    "notebook.cellStatusBarItemHoverBackground": "#44cc44",
    "notebook.cellBorderColor": "#555555",
    "notebook.focusedCellBorder": "#44cc44",
    "notebook.selectedCellBackground": "#2f4c2f",
    "notebook.focusedCellBackground": "#2f4c2f"
  },
  "git.decorations.enabled": true,
  "markdown.experimental.validate.fileLinks.markdownFragmentLinks": "warning",
  "npm-intellisense.packageSubfoldersIntellisense": true,
  "editor.stickyScroll.enabled": true,
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "python.terminal.activateEnvInCurrentTerminal": true,
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.usePythonEnvironmentsExtension": true,
  "python-envs.alwaysUseUv": true,
  "python-envs.defaultEnvManager": "ms-python.python:venv",
  "python-envs.terminal.autoActivationType": "shellStartup",
  "[python]": {
    "files.trimTrailingWhitespace": true,
    "editor.defaultFormatter": "ms-python.black-formatter"
  },
  "workbench.layoutControl.enabled": false,
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[django-html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[shellscript]": {
    "editor.defaultFormatter": "timonwong.shellcheck"
  },
  "[gitignore]": {
    "editor.defaultFormatter": "timonwong.shellcheck"
  },
  "[dotenv]": {
    "editor.defaultFormatter": "dotenv.dotenv-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[erb]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[ruby]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[cfg]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[svelte]": {
    "editor.defaultFormatter": "svelte.svelte-vscode"
  },
  "github.copilot.enable": {
    "*": true,
    "plaintext": true,
    "markdown": false,
    "scminput": false
  },
  "cmake.configureOnOpen": true,
  "C_Cpp.default.compilerPath": "/usr/bin/clang",
  "git.autofetch": true,
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "javascript.format.semicolons": "insert",
  "macros": {
    "commentDown": [
      "editor.action.copyLinesDownAction",
      "cursorUp",
      "editor.action.addCommentLine",
      "cursorDown"
    ],
    "decreaseViewSizeTen": [
      "workbench.action.decreaseViewSize",
      "workbench.action.decreaseViewSize",
      "workbench.action.decreaseViewSize",
      "workbench.action.decreaseViewSize",
      "workbench.action.decreaseViewSize",
      "workbench.action.decreaseViewSize",
      "workbench.action.decreaseViewSize",
      "workbench.action.decreaseViewSize",
      "workbench.action.decreaseViewSize",
      "workbench.action.decreaseViewSize"
    ],
    "increaseViewSizeTen": [
      "workbench.action.increaseViewSize",
      "workbench.action.increaseViewSize",
      "workbench.action.increaseViewSize",
      "workbench.action.increaseViewSize",
      "workbench.action.increaseViewSize",
      "workbench.action.increaseViewSize",
      "workbench.action.increaseViewSize",
      "workbench.action.increaseViewSize",
      "workbench.action.increaseViewSize",
      "workbench.action.increaseViewSize"
    ],
    "increaseViewSizeFive": [
      "workbench.action.increaseViewSize",
      "workbench.action.increaseViewSize",
      "workbench.action.increaseViewSize",
      "workbench.action.increaseViewSize",
      "workbench.action.increaseViewSize",
    ],
    "minimizeAuxiliaryBarWidth": [
      "workbench.action.focusAuxiliaryBar",
      "workbench.action.focusAuxiliaryBar", // need to run twice for ...ViewSize to work
      "macros.decreaseViewSizeTen",
      "macros.decreaseViewSizeTen",
      "macros.decreaseViewSizeTen",
      "macros.decreaseViewSizeTen",
      "macros.decreaseViewSizeTen"
    ],
    "minimizeTerminalWidth": [
      "workbench.action.focusPanel",
      "workbench.action.terminal.focus", // run twice just in case
      "macros.decreaseViewSizeTen",
      "macros.decreaseViewSizeTen",
      "macros.decreaseViewSizeTen",
      "macros.decreaseViewSizeTen",
      "macros.decreaseViewSizeTen"
    ],
    "minimizeTerminalHeight": [
      "workbench.action.focusPanel",
      "workbench.action.terminal.focus", // run twice just in case
      "workbench.action.terminal.resizePaneDown",
      "workbench.action.terminal.resizePaneDown",
      "workbench.action.terminal.resizePaneDown",
      "workbench.action.terminal.resizePaneDown",
      "workbench.action.terminal.resizePaneDown",
      "workbench.action.terminal.resizePaneDown",
      "workbench.action.terminal.resizePaneDown",
      "workbench.action.terminal.resizePaneDown",
      "workbench.action.terminal.resizePaneDown",
      "workbench.action.terminal.resizePaneDown",
    ],
    "minimizeEditorWidth": [
      "workbench.action.focusActiveEditorGroup",
      "workbench.action.focusActiveEditorGroup", // need to run twice for ...ViewSize to work
      "macros.decreaseViewSizeTen",
      "macros.decreaseViewSizeTen",
      "macros.decreaseViewSizeTen",
      "macros.decreaseViewSizeTen",
      "macros.decreaseViewSizeTen"
    ],
    "minimizeSideBarWidth": [
      "workbench.action.focusSideBar",
      "workbench.action.focusSideBar", // need to run twice for ...ViewSize to work
      "macros.decreaseViewSizeTen",
      "macros.decreaseViewSizeTen",
      "macros.decreaseViewSizeTen",
      "macros.decreaseViewSizeTen",
      "macros.decreaseViewSizeTen"
    ],
    "auxiliaryBarToSizeNine": [
      "macros.minimizeAuxiliaryBarWidth",
      "workbench.action.increaseViewSize",
      "workbench.action.increaseViewSize",
      "workbench.action.increaseViewSize",
      "workbench.action.increaseViewSize",
      "workbench.action.increaseViewSize",
      "workbench.action.increaseViewSize",
      "workbench.action.increaseViewSize",
      "workbench.action.increaseViewSize",
      "workbench.action.increaseViewSize"
    ],
    "auxiliaryBarToSizeTen": [
      "macros.minimizeAuxiliaryBarWidth",
      // "workbench.action.increaseViewSize",
      // "workbench.action.increaseViewSize",
      // "workbench.action.increaseViewSize",
      // "workbench.action.increaseViewSize",
      // "workbench.action.increaseViewSize",
      // "workbench.action.increaseViewSize",
      // "workbench.action.increaseViewSize",
      // "workbench.action.increaseViewSize",
      // "workbench.action.increaseViewSize",
      // "workbench.action.increaseViewSize"
    ],
    "editorToSizeFourteen": [
      "macros.minimizeEditorWidth",
      "workbench.action.focusActiveEditorGroup",
      "workbench.action.increaseViewSize",
      "workbench.action.increaseViewSize",
      "workbench.action.increaseViewSize",
      "workbench.action.increaseViewSize",
      "workbench.action.increaseViewSize",
      "workbench.action.increaseViewSize",
      "workbench.action.increaseViewSize",
      "workbench.action.increaseViewSize",
      "workbench.action.increaseViewSize",
      "workbench.action.increaseViewSize",
      "workbench.action.increaseViewSize",
      "workbench.action.increaseViewSize",
      "workbench.action.increaseViewSize",
      "workbench.action.increaseViewSize"
    ],
    "terminalToSizeEight": [
      "workbench.action.focusPanel",
      "workbench.action.terminal.focus",
      "workbench.action.increaseViewSize",
      "workbench.action.increaseViewSize",
      "workbench.action.increaseViewSize",
      "workbench.action.increaseViewSize",
      "workbench.action.increaseViewSize",
      "workbench.action.increaseViewSize",
      "workbench.action.increaseViewSize",
      "workbench.action.increaseViewSize",
    ],
    "terminalToSizeSix": [
      "workbench.action.focusPanel",
      "workbench.action.terminal.focus",
      "workbench.action.increaseViewSize",
      "workbench.action.increaseViewSize",
      "workbench.action.increaseViewSize",
      "workbench.action.increaseViewSize",
      "workbench.action.increaseViewSize",
      "workbench.action.increaseViewSize",
    ],
    "terminalToSizeFour": [
      "workbench.action.focusPanel",
      "workbench.action.terminal.focus",
      "workbench.action.increaseViewSize",
      "workbench.action.increaseViewSize",
      "workbench.action.increaseViewSize",
      "workbench.action.increaseViewSize"
    ],
    "terminalToSizeTwo": [
      "macros.minimizeTerminalWidth",
      "workbench.action.focusPanel",
      "workbench.action.terminal.focus",
      "workbench.action.increaseViewSize",
      "workbench.action.increaseViewSize"
    ],
    "sideBarToSizeTwo": [
      "workbench.action.focusSideBar",
      "workbench.action.increaseViewSize"
    ],
    "closePrimarySidebar": [
      "workbench.action.focusSideBar",
      "workbench.action.toggleSidebarVisibility"
    ],
    "closePrimaryAuxiliaryBar": [
      "workbench.action.focusAuxiliaryBar",
      "workbench.action.toggleAuxiliaryBar"
    ]
  },
  "window.zoomLevel": -1,
  "notebook.output.scrolling": true,
  "notebook.output.wordWrap": true,
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "cmake.options.statusBarVisibility": "visible",
  "[dockerfile]": {
    "editor.defaultFormatter": "ms-azuretools.vscode-docker"
  },
  "cmake.showOptionsMovedNotification": false,
  "rubyLsp.rubyVersionManager": {
    "identifier": "mise"
  },
  "editor.defaultFormatter": "ms-python.black-formatter",
  "github.copilot.chat.localeOverride": "en",
  "github.copilot.chat.fixTestFailures": true,
  "github.copilot.editor.enableAutoCompletions": true,
  "githubPullRequests.pullBranch": "never",
  "svelte.enable-ts-plugin": true,
  "flake8.args": [
        "--exclude=venv*,__pycache__,node_modules,cache,migrations,build,sample_cap_xml_documents.py",
        "--max-line-length=120",
        "--extend-ignore=B306,W504,F541,E203,E302,E305",
        "--per-file-ignores=.env:E501"
    ],
    "git.openRepositoryInParentFolders": "never",
    "explorer.fileNesting.patterns": {
      "*.ts": "${capture}.js",
      "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
      "*.jsx": "${capture}.js",
      "*.tsx": "${capture}.ts",
      "tsconfig.json": "tsconfig.*.json",
      "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb",
      "*.sqlite": "${capture}.${extname}-*",
      "*.db": "${capture}.${extname}-*",
      "*.sqlite3": "${capture}.${extname}-*",
      "*.db3": "${capture}.${extname}-*",
      "*.sdb": "${capture}.${extname}-*",
      "*.s3db": "${capture}.${extname}-*"
    },
    "workbench.sideBar.location": "right",
    "diffEditor.codeLens": true,
    "makefile.configureOnOpen": true,
    "security.workspace.trust.untrustedFiles": "open",
    "chat.editing.alwaysSaveWithGeneratedChanges": true,
    "application.shellEnvironmentResolutionTimeout": 60,
    "svg.preview.transparencyGrid": true,
    "geminicodeassist.project": "jimaisandbox",
    "geminicodeassist.enableTelemetry": false,
    "geminicodeassist.inlineSuggestions.enableAuto": false,
    "java.debug.logLevel": "verbose",
    "editor.tokenColorCustomizations": {
      "[*Light*]": {
        "textMateRules": [
          {
            "scope": "ref.matchtext",
            "settings": {
              "foreground": "#000"
            }
          }
        ]
      },
      "[*Dark*]": {
        "textMateRules": [
          {
            "scope": "ref.matchtext",
            "settings": {
              "foreground": "#fff"
            }
          }
        ]
      },
      "textMateRules": []
    },
    "dotenv.enableAutocloaking": false
}
