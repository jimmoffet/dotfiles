# execute command in a new Terminal.app window
newterm() {
  echo "newterm: run a command in a new Terminal.app window. Usage: newterm <command>"
  var=$@
  osascript - "$var" <<EOF
    on run argv -- argv is a list of strings
      tell application "Terminal"
        activate
        delay 3
        do script (item 1 of argv)
        delay 1
        close the front window
      end tell
    end run
EOF
}

alias boop='open -a boop'

installdotfiles() {
  echo "installdotfiles: run dotfiles install steps or show available install commands. Usage: installdotfiles [help|install_step]"
  if [ "$1" = "help" ]; then
    echo "Usage: dot <command>"
    declare -a funcs=(
      "create_dirs"
      "build_xcode"
      "install_brew"
      "mac_defaults_write"
      "install_docker"
      #   "configure_ruby"
      "configure_node"
      "configure_python"
      "configure_vim"
      "set_up_aws"
      "stow_dotfiles"
      "set_up_vscode"
      "set_up_touchid"
    )
    for i in "${funcs[@]}"; do
      printf "dot $i\n"
    done
  else
    $HOME/dotfiles/install.sh $@
  fi
}

LIGHTBLUE="\e[94m"
ENDCOLOR="\e[0m"
GREEN="\e[92m"
CYAN="\e[96m"
YELLOW="\e[93m"
RED="\e[91m"

dot() {
  echo "dot: list every function and its first echo/help line. Usage: dot"

  local aliases_file="$HOME/dotfiles/zsh/.aliases"

  if [ ! -f "$aliases_file" ]; then
    echo -e "${RED}Could not find aliases file:${ENDCOLOR} $aliases_file"
    return 1
  fi

  local rows
  rows=$(awk '
    function trim(s) {
      sub(/^[[:space:]]+/, "", s)
      sub(/[[:space:]]+$/, "", s)
      return s
    }

    /^[[:space:]]*[A-Za-z_][A-Za-z0-9_-]*[[:space:]]*\(\)[[:space:]]*\{/ {
      line = $0
      sub(/^[[:space:]]*/, "", line)
      fn = line
      sub(/[[:space:]]*\(\)[[:space:]]*\{.*/, "", fn)
      in_fn = 1
      next
    }

    in_fn {
      if ($0 ~ /^[[:space:]]*$/) {
        next
      }

      line = $0
      if (line ~ /^[[:space:]]*echo([[:space:]]|$)/) {
        sub(/^[[:space:]]*echo([[:space:]]+-e)?[[:space:]]*/, "", line)
        line = trim(line)

        if (line ~ /^"/) {
          sub(/^"/, "", line)
          sub(/"$/, "", line)
        } else if (line ~ /^\047/) {
          sub(/^\047/, "", line)
          sub(/\047$/, "", line)
        }

        print fn "\t" line
      } else {
        print fn "\t(no first echo line found)"
      }

      in_fn = 0
    }
  ' "$aliases_file")

  echo -e "\n${CYAN}📚 Dotfiles Function Help${ENDCOLOR}"
  local fn_col_width=24
  local term_width="${COLUMNS:-$(tput cols 2>/dev/null || echo 100)}"

  if ! [[ "$term_width" =~ ^[0-9]+$ ]]; then
    term_width=100
  fi

  local min_width=$((fn_col_width + 30))
  if [ "$term_width" -lt "$min_width" ]; then
    term_width="$min_width"
  fi

  local help_width=$((term_width - fn_col_width - 1))
  local divider
  divider=$(printf "%*s" "$term_width" "" | tr ' ' '─')

  echo -e "${LIGHTBLUE}${divider}${ENDCOLOR}"

  local count=0
  local wrapped_help
  local formatted_help
  local first_line
  local line
  while IFS=$'\t' read -r fn help_line; do
    [ -z "$fn" ] && continue
    count=$((count + 1))

    if [[ "$help_line" == "$fn: "* ]]; then
      help_line="${help_line#"$fn: "}"
    fi

    formatted_help=$(printf "%s" "$help_line" | sed 's/[[:space:]]\+Usage:/\
Usage:/')
    wrapped_help=$(printf "%s" "$formatted_help" | fold -s -w "$help_width")

    first_line=true
    while IFS= read -r line; do
      if [ "$first_line" = true ]; then
        builtin printf "${YELLOW}%*s${ENDCOLOR} ${LIGHTBLUE}%s${ENDCOLOR}\n" "$fn_col_width" "$fn" "$line"
        first_line=false
      elif [[ "$line" == Usage:* ]]; then
        local usage_args="${line#Usage: }"
        builtin printf "%-*s ${LIGHTBLUE}Usage:${ENDCOLOR} ${YELLOW}%s${ENDCOLOR}\n" "$fn_col_width" "" "$usage_args"
      else
        builtin printf "%-*s ${LIGHTBLUE}%s${ENDCOLOR}\n" "$fn_col_width" "" "$line"
      fi
    done <<< "$wrapped_help"

    builtin printf "\n"
  done <<< "$rows"

  echo -e "${LIGHTBLUE}${divider}${ENDCOLOR}"
  echo -e "${GREEN}Total functions:${ENDCOLOR} $count"
}

# find stuff
findall() {
  echo "findall: search the filesystem with custom find arguments (excluding common system paths). Usage: findall <find-args>"
  find / -path '*/Library/*' -prune -o -path '/System/*' -prune -o -path '/private/*' -prune -o -path '/dev/*' -prune -o -path '/usr/sbin/authserver' -prune -o $@ -print
  echo "\n${LIGHTBLUE}Tip: findall -type d -name 'screenshots'${ENDCOLOR}"
}

finddir() {
  echo "finddir: find directories by case-insensitive name (excluding common system paths). Usage: finddir <name-pattern>"
  find / -path '*/Library/*' -prune -o -path '/System/*' -prune -o -path '/private/*' -prune -o -path '/dev/*' -prune -o -path '/usr/sbin/authserver' -prune -o -type d -iname $@ -print
  echo "\n${LIGHTBLUE}Tip: finddir scrEenShotS${ENDCOLOR}"
}

findfile() {
  echo "findfile: find files by case-insensitive name (excluding common system paths). Usage: findfile <name-pattern>"
  find / -path '*/Library/*' -prune -o -path '/System/*' -prune -o -path '/private/*' -prune -o -path '/dev/*' -prune -o -path '/usr/sbin/authserver' -prune -o -type f -iname $@ -print
  echo "\n${LIGHTBLUE}Tip: findfile brEW${ENDCOLOR}"
}

findin() {
  echo "findin: search within a specific root path by type and case-insensitive name. Usage: findin <root-path> <f|d> <name-pattern>"
  find $1 -path '*/Library/*' -prune -o -path '/System/*' -prune -o -path '/private/*' -prune -o -path '/dev/*' -prune -o -path '/usr/sbin/authserver' -prune -o -type $2 -iname $3 -print
  echo "\n${LIGHTBLUE}Tip: findin $HOME d screenshots${ENDCOLOR}"
}

findprocess() {
  echo "findprocess: search running processes using grep. Usage: findprocess <pattern>"
  ps ax | grep $@
  echo "\n${LIGHTBLUE}Note: case-sensitive Tip: findprocess Google${ENDCOLOR}"
}

killallprocesses() {
  echo "killallprocesses: kill processes by full command-line match. Usage: killallprocesses <pattern>"
  pkill -f $@
  echo "\n${LIGHTBLUE}Note: case-sensitive Tip: findprocess Google${ENDCOLOR}"
}

# OpenAI API Key management
set_openai_key() {
  echo "set_openai_key: store an OpenAI API key in macOS Keychain. Usage: set_openai_key <api-key>"
  if [ -z "$1" ]; then
    echo "Usage: set_openai_key <api-key>"
    echo "This will securely store your OpenAI API key in macOS Keychain"
    return 1
  fi
  security add-generic-password -a "$USER" -s "openai-api-key" -w "$1" -U
  echo "OpenAI API key stored securely in Keychain"
}

check_openai_key() {
  echo "check_openai_key: verify whether an OpenAI API key exists in Keychain. Usage: check_openai_key"
  local key
  key=$(security find-generic-password -a "$USER" -s "openai-api-key" -w 2>/dev/null)
  if [ $? -eq 0 ] && [ -n "$key" ]; then
    echo -e "OpenAI API key found in Keychain (first 10 chars: ${YELLOW}${key:0:10}...${ENDCOLOR})"
  else
    echo "No OpenAI API key found in Keychain"
    echo -e "Use '${YELLOW}set_openai_key <your-key>${ENDCOLOR}' to store it securely"
  fi
}

# git
alias g="git"

display_commit_summary() {
  echo "display_commit_summary: print a commit stats and message summary. Usage: display_commit_summary \"<commit-message>\""
  local commit_msg="$1"

  # Get diff stats
  local stats
  stats=$(git diff --stat HEAD~1 HEAD 2>/dev/null)
  if [ -n "$stats" ]; then
    echo -e "${CYAN}📊 Committed Changes:${ENDCOLOR}\n"
    echo "$stats" | while IFS= read -r line; do
      if [[ "$line" =~ [0-9]+.*file.*changed ]]; then
        echo -e "   ${YELLOW}$line${ENDCOLOR}"
      else
        echo "   $line"
      fi
    done
  fi

  printf "\n"

  # Display a nice summary
  echo -e "${CYAN}\n📝 Commit Message:${ENDCOLOR}"
  printf "\n"
  # Display commit message with proper multi-line formatting
  echo "$commit_msg" | while IFS= read -r line; do
    if [ -n "$line" ]; then
      echo "    $(echo "$line" | sed 's/^[[:space:]]*//')"
    else
      echo ""
    fi
  done
}

gitgo() {
  echo "gitgo: commit all changes, write auto-message and push current branch. Usage: gitgo [optional-commit-guidance]"
  # Use commit() function to handle the commit part (suppress summary)
  if ! commit --from-gitgo "$@"; then
    echo -e "\n${LIGHTBLUE}Commit failed, aborting push${ENDCOLOR}"
    return 1
  fi

  # Push to remote
  if ! git push; then
    return 1
  fi

  # Get the commit message for the summary
  local commit_msg
  commit_msg=$(git log -1 --pretty=format:"%B")

  # Display summary after push
  display_commit_summary "$commit_msg"

  #TODO: detect all TODO lines in current branch and print them at end of function
}

commit() {
  echo "commit: stage all changes and create a commit (AI by default). Usage: commit [--no-ai] [message]"
  local user_msg="$1"
  local commit_msg
  local use_ai=true
  local from_gitgo=false

  # Check for --from-gitgo flag (internal use)
  if [ "$1" = "--from-gitgo" ]; then
    from_gitgo=true
    shift
    user_msg="$1"
  fi

  # Check for --no-ai flag
  if [ "$1" = "--no-ai" ]; then
    use_ai=false
    user_msg="$2"
  fi

  git add .

  echo "Added all staged files. Generating commit msg..."

  # Generate commit message
  if [ "$use_ai" = true ]; then
    # Capture both stdout and stderr to detect specific failures
    ai_output=$(~/dotfiles/.venv/bin/python ~/dotfiles/scripts/ai_commit.py "$user_msg" 2>&1)
    ai_exit_code=$?

    if [ $ai_exit_code -eq 0 ]; then
      commit_msg="$ai_output"
    else
      # AI failed - show error and exit
      echo -e "\n${YELLOW}⚠️  AI commit generation failed:${ENDCOLOR}"
      echo "$ai_output"
      echo -e "\n${LIGHTBLUE}💡 To commit manually, use:${ENDCOLOR} ${YELLOW}commit --no-ai 'your message'${ENDCOLOR}"
      return 1
    fi
  else
    commit_msg="$user_msg"
  fi

  # Ensure we have a commit message
  if [ -z "$commit_msg" ]; then
    echo "Commit msg from AI: $commit_msg"
    echo -e "\n${YELLOW}⚠️  AI commit generation failed:${ENDCOLOR}"
    echo "$ai_output"
    echo -e "\n${LIGHTBLUE}💡 To commit manually, use:${ENDCOLOR} ${YELLOW}commit --no-ai 'your message'${ENDCOLOR}"
    return 1
  fi

  if ! git commit -m "$commit_msg"; then
    echo -e "\n${LIGHTBLUE}Commit failed${ENDCOLOR}"
    return 1
  fi

  # Display summary only if not called from gitgo()
  if [ "$from_gitgo" = false ]; then
    display_commit_summary "$commit_msg"
  fi

}

cleandocker() {
  echo "cleandocker: remove unused Docker images, volumes, networks, and builder cache. Usage: cleandocker"
  docker image prune -a -f && docker volume prune -f && docker network prune -f && docker builder prune -a -f
}

