# pull-request
gpr() {
  echo "gpr: create a GitHub PR targeting main from current branch. Usage: gpr \"<pr-body>\""
  gh pr create --base main --head $(git rev-parse --abbrev-ref HEAD) --title $(git rev-parse --abbrev-ref HEAD) --body $1
}

# AI-powered pull request
pr() {
  echo "pr: create a GitHub PR with optional AI-generated content. Usage: pr [--no-ai] [--draft] [--dry-run] [--template <name>] [--base <branch>] [guidance]"
  local guidance=""
  local use_ai=true
  local draft=false
  local dry_run=false
  local template=""
  local base=""

  # Parse arguments
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --no-ai)
      use_ai=false
      shift
      ;;
    --draft)
      draft=true
      shift
      ;;
    --dry-run)
      dry_run=true
      shift
      ;;
    --template)
      template="$2"
      shift 2
      ;;
    --base)
      base="$2"
      shift 2
      ;;
    *)
      # Remaining args are guidance text
      guidance="$*"
      break
      ;;
    esac
  done

  # Push current branch first if it has commits (skip in dry-run)
  if [ "$dry_run" = false ]; then
    echo "Pushing current branch..."
    if ! git push -u origin HEAD 2>/dev/null; then
      echo -e "${YELLOW}⚠️  Push failed or branch already pushed${ENDCOLOR}"
    fi
  fi

  # Build command
  local cmd="$HOME/dotfiles/.venv/bin/python $HOME/dotfiles/scripts/ai_pull_request.py"

  if [ "$use_ai" = false ]; then
    cmd="$cmd --no-ai"
  fi

  if [ "$draft" = true ]; then
    cmd="$cmd --draft"
  fi

  if [ "$dry_run" = true ]; then
    cmd="$cmd --dry-run"
  fi

  if [ -n "$template" ]; then
    cmd="$cmd --template $template"
  fi

  if [ -n "$base" ]; then
    cmd="$cmd --base $base"
  fi

  if [ -n "$guidance" ]; then
    cmd="$cmd \"$guidance\""
  fi

  # Execute and capture output
  pr_output=$(eval $cmd 2>&1)
  pr_exit_code=$?

  if [ $pr_exit_code -eq 0 ]; then
    if [ "$dry_run" = true ]; then
      # Dry run - just show output
      echo "$pr_output"
    else
      # Success - display PR URL
      echo -e "\n${GREEN}✓ Pull Request Created!${ENDCOLOR}"
      echo -e "${CYAN}$pr_output${ENDCOLOR}\n"
    fi
  else
    # Failed
    echo -e "\n${YELLOW}⚠️  PR creation failed:${ENDCOLOR}"
    echo "$pr_output"
    echo -e "\n${LIGHTBLUE}💡 To create PR manually, use:${ENDCOLOR} ${YELLOW}gh pr create${ENDCOLOR}"
    return 1
  fi
}

